# Metadata database for drills and run history. Create it before make migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pgrestoredrill
# Maintenance connection. The drill creates a throwaway pgrestoredrill_<id> database
# and never restores into this one. The role needs CREATEDB.
TARGET_URL=postgresql://postgres:postgres@localhost:5432/postgres
LOG_LEVEL=INFO
# Bearer token for the run-history API. Empty refuses every authenticated request.
ADMIN_TOKEN=
# Optional S3 credentials. When both are empty, boto3 uses its default chain.
# Do not put real keys here.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional JSON webhook. Empty sends nothing. The URL is not logged.
ALERT_WEBHOOK_URL=
